task get_test_result();
  automatic bit match = 1;
  automatic test_result_t test_result = TEST_PASSED;
  if (sout0_frames.size() != exp_sout0_frames.size()) match = 0;
  else begin
    for (int i = 0; i < sout0_frames.size(); i++) begin
      if (sout0_frames[i] !== exp_sout0_frames[i]) match = 0;
    end
  end

  if (sout1_frames.size() != exp_sout1_frames.size()) match = 0;
  else begin
    for (int i = 0; i < sout1_frames.size(); i++) begin
      if (sout1_frames[i] !== exp_sout1_frames[i]) match = 0;
    end
  end

  if (!match) begin
    test_result = TEST_FAILED;
  end else begin
    test_result = TEST_PASSED;
  end

  case(test)
    NONE: begin
    end
    NO_ADDR_SET: begin
      if(!match) begin
        $display("TEST_NO_ADDR_SET ERROR: FRAMES IN UNEXPECTED LOCATION \n");
      end
      else begin
        $display("TEST_NO_ADDR_SET: \n");
      end
    end
    PROPER_FRAME: begin
      if(!match) begin
        $display("TEST_PROPER_FRAME ERROR: FRAMES IN UNEXPECTED LOCATION \n");
      end
      else begin
        $display("TEST_PROPER_FRAME: \n");
      end
    end
    SW_RESET: begin
      if(!match) begin
        $display("TEST_SW_RESET ERROR: FRAMES IN UNEXPECTED LOCATION (This error is expected. Appear because there is no possibility to reset adress array during test.) \n");
      end
      else begin
        $display("TEST_PROPER_FRAME: \n");
      end
    end
    WRONG_START_BIT: begin
      if(!match) begin
        $display("TEST_WRONG_START_BIT ERROR: UNEXPECTED FRAMES APPERAED (This error is expected. If appear, everything works OK ) \n");
      end
      else begin
        $display("TEST_PROPER_FRAME: \n");
      end
    end
    WRONG_PARITY_BIT: begin
      if(!match) begin
        $display("TEST_WRONG_PARITY_BIT ERROR: UNEXPECTED FRAMES APPERAED \n");
      end
      else begin
        $display("TEST_WRONG_PARITY_BIT: \n");
      end
    end
    WRONG_STOP_BIT: begin
      if(!match) begin
        $display("TEST_WRONG_STOP_BIT ERROR: UNEXPECTED FRAMES APPERAED \n");
      end
      else begin
        $display("TEST_WRONG_STOP_BIT: \n");
      end
    end
    WRONG_START_PARITY_STOP: begin
      if(!match) begin
        $display("TEST_WRONG_START_PARITY_STOP_BIT ERROR: UNEXPECTED FRAMES APPERAED (This error is expected. If appear, everything works OK ) \n");
      end
      else begin
        $display("TEST_WRONG_START_PARITY_STOP_BIT: \n");
      end
    end
    END_TEST: begin
    end
    default: begin
    end
  endcase

  print_test_result(test_result);
endtask

//------------------------------------------------------------------------------
// UART switch handling tasks
//------------------------------------------------------------------------------

function frame_status_t build_uart_msg (input logic prog_mode, input byte data, start_bit_set_t start_set, parity_bit_set_t parity_set, stop_bit_set_t stop_set);
  logic [10:0] buffer;
  bit parity_bit;
  int array_size;

  case (start_set)
    START_B_OK: begin
      buffer[10] = 0;
    end
    START_B_ERR: begin
      buffer[10] = 1;
    end
    default: begin
      buffer[10] = 1;
    end
  endcase

  for (int i = 0 ; i <8 ; i++)begin
    buffer[9 - i] = data[i];
  end

  case (parity_set)
    PARITY_B_OK: begin
      parity_bit = ^data;
      buffer[1] = parity_bit;
    end
    PARITY_B_ERR: begin
      parity_bit = ~^data;
      buffer[1] = parity_bit;
    end
    default: begin
      parity_bit = ^data;
      buffer[1] = parity_bit;
    end
  endcase

  case (stop_set)
    STOP_B_OK: begin
      buffer[0] = 1;
    end
    STOP_B_ERR: begin
      buffer[0] = 0;
    end
    default: begin
      buffer[10] = 1;
    end
  endcase

  array_size = frame_data.size();
  frame_data = new[array_size + 1](frame_data);
  frame_data[array_size].prog_mode = prog_mode;
  frame_data[array_size].input_message = buffer;

  if (start_set == START_B_ERR || parity_set == PARITY_B_ERR || stop_set == STOP_B_ERR) begin
    return ERR;
  end
  else begin
    return OK;
  end
endfunction

task transmit_data();
  foreach(frame_data[i]) begin
    for (int j = 10; j >= 0 ; j--) begin
      prog = frame_data[i].prog_mode;
      sin = frame_data[i].input_message[j];
      repeat(CLKS_PER_BIT)@(negedge clk);
    end
  end

  frame_data.delete;
endtask

task automatic monitor_sout0();
  logic[10:0] buffer = '0;
  int array_size;

  forever begin
    @(negedge clk);

    if(sout0 == 0)begin
      repeat(CLKS_PER_BIT/2)@(negedge clk);
      for(int i = 0 ; i <= 9 ; i++) begin
        buffer[i] = sout0;
        repeat(CLKS_PER_BIT)@(negedge clk);
      end 

      array_size = sout0_frames.size();
      sout0_frames = new[array_size + 1](sout0_frames);
      sout0_frames[array_size] = buffer[8:1];
    end
  end
endtask

task automatic monitor_sout1();
  logic[10:0] buffer = '0;
  int array_size;
  int frame_index = 0;

  forever begin
    @(negedge clk);

    if(sout1 == 0)begin
      repeat(CLKS_PER_BIT/2)@(negedge clk);
      for(int i = 0 ; i <= 9 ; i++) begin
        buffer[i] = sout1;
        repeat(CLKS_PER_BIT)@(negedge clk);
      end 

      array_size = sout1_frames.size();
      sout1_frames = new[array_size + 1](sout1_frames);
      sout1_frames[array_size] = buffer[8:1];
    end
  end
endtask

//------------------------------------------------------------------------------
// Other functions
//------------------------------------------------------------------------------

// used to modify the color of the text printed on the terminal
function void set_print_color ( print_color_t c );
  string ctl;
  case(c)
      COLOR_BOLD_BLACK_ON_GREEN : ctl  = "\033\[1;30m\033\[102m";
      COLOR_BOLD_BLACK_ON_RED : ctl    = "\033\[1;30m\033\[101m";
      COLOR_BOLD_BLACK_ON_YELLOW : ctl = "\033\[1;30m\033\[103m";
      COLOR_BOLD_BLUE_ON_WHITE : ctl   = "\033\[1;34m\033\[107m";
      COLOR_BLUE_ON_WHITE : ctl        = "\033\[0;34m\033\[107m";
      COLOR_DEFAULT : ctl              = "\033\[0m\n";
      default : begin
          $error("set_print_color: bad argument");
          ctl                          = "";
      end
  endcase
  $write(ctl);
endfunction

  function void print_test_result (test_result_t r);
    if(r == TEST_PASSED) begin
        set_print_color(COLOR_BOLD_BLACK_ON_GREEN);
        $write ("-----------------------------------\n");
        $write ("----------- Test PASSED -----------\n");
        $write ("-----------------------------------");
        set_print_color(COLOR_DEFAULT);
        $write ("\n");
    end
    else begin
        set_print_color(COLOR_BOLD_BLACK_ON_RED);
        $write ("-----------------------------------\n");
        $write ("----------- Test FAILED -----------\n");
        $write ("-----------------------------------");
        set_print_color(COLOR_DEFAULT);
        $write ("\n");
    end
endfunction

endmodule : test