module test;

//------------------------------------------------------------------------------
// Type definitions
//------------------------------------------------------------------------------

  typedef enum bit {
    TEST_PASSED,
    TEST_FAILED
  } test_result_t;

  typedef enum {
    COLOR_BOLD_BLACK_ON_GREEN,
    COLOR_BOLD_BLACK_ON_RED,
    COLOR_BOLD_BLACK_ON_YELLOW,
    COLOR_BOLD_BLUE_ON_WHITE,
    COLOR_BLUE_ON_WHITE,
    COLOR_DEFAULT
  } print_color_t;

  typedef enum bit {
    START_B_OK,
    START_B_ERR
  }start_bit_set_t;

  typedef enum bit {
    PARITY_B_OK,
    PARITY_B_ERR
  }parity_bit_set_t;

  typedef enum bit {
    STOP_B_OK,
    STOP_B_ERR
  }stop_bit_set_t;

  typedef enum bit {
    OK,
    ERR
  }frame_status_t;

  typedef enum logic[3:0] {
    NONE,
    NO_ADDR_SET,
    PROPER_FRAME,
    SW_RESET,
    WRONG_START_BIT,
    WRONG_PARITY_BIT,
    WRONG_STOP_BIT,
    WRONG_START_PARITY_STOP,
    END_TEST
  }test_t;

  typedef struct{
    logic prog_mode;
    logic [10:0] input_message;
  } frame_data_t;

//------------------------------------------------------------------------------
// Local variables
//------------------------------------------------------------------------------

  logic clk;
  logic rst_n;
  logic prog; //(prog) // 1=programming, 0=functional
  logic sin; 
  logic sout0;
  logic sout1;

  frame_data_t frame_data [];
  test_t test = NONE;

  logic[7:0] sout0_frames [];
  logic[7:0] sout1_frames [];
  logic[7:0] exp_sout0_frames [];
  logic[7:0] exp_sout1_frames [];

//------------------------------------------------------------------------------
// Local parameters
//------------------------------------------------------------------------------
  localparam int CLKS_PER_BIT = 16;
  localparam int FRAME_LENGTH = 11;
  localparam byte PORT_SOUT0 = 8'h00;
  localparam byte PORT_SOUT1 = 8'h01;
//------------------------------------------------------------------------------
// DUT instantiation
//------------------------------------------------------------------------------

simple_switch_uart DUT (.clk, .rst_n, .prog, .sin, .sout0, .sout1);

//------------------------------------------------------------------------------
// Clock generator
//------------------------------------------------------------------------------

initial begin : clk_gen_blk
  clk = 0;
  forever #10 clk = ~clk;
end

//------------------------------------------------------------------------------
//reset_tasks
//------------------------------------------------------------------------------
task reset_sw();
  rst_n = 0;
  prog = 0;
  sin = 1; // idle = 1
  @(negedge clk);
  rst_n = 1;
endtask

task reset_arrays();
  sout0_frames.delete;
  sout1_frames.delete;
  exp_sout0_frames.delete;
  exp_sout1_frames.delete;
endtask

//------------------------------------------------------------------------------
//Tester
//------------------------------------------------------------------------------
initial begin : tpgen
  
    //repeat(1) begin:tpgen_main
      fork
        monitor_sout0();
        monitor_sout1();
      join_none

      forever begin
        case(test)
          NONE: begin
            test = NO_ADDR_SET;
          end
          NO_ADDR_SET: begin
            no_addr_set_test();
            get_test_result();
            test = PROPER_FRAME;
          end
          PROPER_FRAME: begin
            proper_frame_test();
            get_test_result();
            test = SW_RESET;
          end
          SW_RESET: begin
            sw_reset_test();
            get_test_result();
            test = WRONG_START_BIT;
          end
          WRONG_START_BIT: begin
            wrong_start_bit_test();
            get_test_result();
            test = WRONG_PARITY_BIT;
          end
          WRONG_PARITY_BIT: begin
            wrong_parity_bit_test();
            get_test_result();    
            test = WRONG_STOP_BIT;
          end
          WRONG_STOP_BIT: begin
            wrong_stop_bit_test();
            get_test_result();
            test = WRONG_START_PARITY_STOP;
          end
          WRONG_START_PARITY_STOP: begin
            wrong_start_parity_stop_bit_test();
            get_test_result();
            test = END_TEST;
          end
          END_TEST: begin
            $finish;
          end
          default: begin
            test = NONE;
          end
        endcase
      end
    end
//end : tpgen


function byte get_random();
  return $random & 8'hFF;
endfunction : get_random

//------------------------------------------------------------------------------
// Test procedures tasks
//------------------------------------------------------------------------------

task no_addr_set_test();
  int array_size;
  bit addr_arr [0:'hFF];
  byte addr_val_arr [0:'hFF];
  byte addr;
  byte data;
  int index;
  frame_status_t ret;

  reset_sw();
  reset_arrays();
  #16

  for(int k = 0 ; k <= 'hFF ; k++) begin
    addr = get_random();
    data = get_random();
    ret = build_uart_msg (0, addr, START_B_OK, PARITY_B_OK, STOP_B_OK);
    ret = build_uart_msg (0, data, START_B_OK, PARITY_B_OK, STOP_B_OK);

    array_size = exp_sout0_frames.size();
    exp_sout0_frames = new[array_size + 2](exp_sout0_frames);
    exp_sout0_frames[array_size] = addr;
    exp_sout0_frames[array_size + 1] = data;
      
  end

  transmit_data();
  
  repeat(2 * FRAME_LENGTH * CLKS_PER_BIT)@(negedge clk);
endtask

task proper_frame_test();
  int array_size;
  bit addr_arr [0:'hFF];
  byte addr_val_arr [0:'hFF];
  byte addr;
  byte data;
  int index;
  frame_status_t ret;

  reset_sw();
  reset_arrays();
  #16

  for(int i = 0 ; i <= 'hFF ; i++) begin
    addr_arr[i] = get_random() & 'b1;
    addr_val_arr[i] = get_random();
  end

  for(int j = 0 ; j <= 'hFF ; j++) begin
    if(addr_arr[j] == 0) begin
      ret = build_uart_msg (1, addr_val_arr[j], START_B_OK, PARITY_B_OK, STOP_B_OK);
      ret = build_uart_msg (1, PORT_SOUT0, START_B_OK, PARITY_B_OK, STOP_B_OK);
    end
    else begin
      ret = build_uart_msg (1, addr_val_arr[j], START_B_OK, PARITY_B_OK, STOP_B_OK);
      ret = build_uart_msg (1, PORT_SOUT1, START_B_OK, PARITY_B_OK, STOP_B_OK);
    end
  end

  for(int k = 0 ; k <= 'hFF ; k++) begin
    addr = get_random();

    for(int l = 'hFF ; l >= 0 ; l--) begin
      if(addr_val_arr[l] == addr)begin
        index = l;
        break;
      end
      else begin
        index = -1;
      end
    end
    
    data = get_random();
    ret = build_uart_msg (0, addr, START_B_OK, PARITY_B_OK, STOP_B_OK);
    ret = build_uart_msg (0, data, START_B_OK, PARITY_B_OK, STOP_B_OK);

    case(ret)
      OK: begin
        if(index >= 0)begin
          if(addr_arr[index] == 0) begin
            array_size = exp_sout0_frames.size();
            exp_sout0_frames = new[array_size + 2](exp_sout0_frames);
            exp_sout0_frames[array_size] = addr;
            exp_sout0_frames[array_size + 1] = data;
          end
          else if(addr_arr[index] == 1) begin
            array_size = exp_sout1_frames.size();
            exp_sout1_frames = new[array_size + 2](exp_sout1_frames);
            exp_sout1_frames[array_size] = addr;
            exp_sout1_frames[array_size + 1] = data;
          end
          else begin
          end
        end
        else begin 
          array_size = exp_sout0_frames.size();
            exp_sout0_frames = new[array_size + 2](exp_sout0_frames);
            exp_sout0_frames[array_size] = addr;
            exp_sout0_frames[array_size + 1] = data;
        end
      end
      ERR: begin
      end
      default: begin
      end
    endcase
    
  end

  transmit_data();

  repeat(2 * FRAME_LENGTH * CLKS_PER_BIT)@(negedge clk);
endtask

